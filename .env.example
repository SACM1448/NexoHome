# Puerto local publicado por Docker Compose.
NEXO_PORT=8000
# El origen debe coincidir exactamente con el enviado por el cliente (sin / final).
NEXO_ORIGIN=http://localhost:8000
# production exige NEXO_ORIGIN=https://... y activa cookie Secure.
NEXO_ENV=development
# Solo ejecución Python local; Docker utiliza /data y un volumen con nombre.
NEXO_DATA_DIR=./data
# Caché de métricas y refresco visible (5–300 segundos).
NEXO_METRICS_INTERVAL=30
# HTTPS LAN: usar únicamente compose.lan.yaml, sin combinar con compose.yaml.
# IP privada concreta del equipo servidor; nunca 0.0.0.0.
# NEXO_LAN_IP=192.168.1.50
# NEXO_LAN_HOST=nexo.home.arpa

# Caducidad del contexto temporal por inactividad (60–86400 segundos).
NEXO_CONTEXT_TTL=900
